{
  "version": 2,
  "name": "euro-stats-pro",
  "builds": [
    {
      "src": "site/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/site/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    }
  ]
}
